---
interface Props { title?: string }
const { title = 'Mahābhārata — The Painted Epic' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Rozha+One&family=Spectral:ital,wght@0,400;0,600;1,400&family=Kalam:wght@400;700&family=Tiro+Devanagari+Sanskrit&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
<style is:global>
  /* Srikalahasti Kalamkari palette — see claude/scene-page-design.md */
  :root {
    --cotton: #f6ecd8; --cotton-deep: #eedfc0; --caption: #fbf4e4;
    --ink: #2b2018; --madder: #a63a2b; --madder-brown: #8a2f22;
    --indigo: #2e4377; --ochre: #c9973a; --leaf: #5b7a46; --muted: #6e5b45;
  }
  html, body { margin: 0; background: var(--cotton); color: var(--ink); }
  body { font: 18px/1.6 'Spectral', Georgia, serif; }
  h1, h2, h3 { font-family: 'Rozha One', serif; color: var(--madder-brown); font-weight: 400; }
  [lang="sa"] { font-family: 'Tiro Devanagari Sanskrit', serif; }
</style>
