---
import "../styles/tokens.css";
import "../styles/reader.css";
// fonts, self-hosted (no Google Fonts request). Type set "Old press" (owner, 2026-11-22):
// IM Fell English SC for headings and labels, Alegreya for body text, Tiro Devanagari Sanskrit for Sanskrit.
import "@fontsource/im-fell-english-sc/400.css";
import "@fontsource/alegreya/400.css"; import "@fontsource/alegreya/500.css"; import "@fontsource/alegreya/700.css"; import "@fontsource/alegreya/400-italic.css";
import "@fontsource/tiro-devanagari-sanskrit/400.css";
interface Props { title?: string }
const { title = "Mahābhārata — The Painted Epic" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="The Mahābhārata as a painted, scroll-driven journey in the manner of Srikalahasti Kalamkari: follow a soul or go to a place, always onward in time." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>
