---
import "../styles/tokens.css";
import "../styles/reader.css";
interface Props { title?: string }
const { title = "Mahābhārata — The Painted Epic" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Gotu&family=Rozha+One&family=Kalam:wght@400;700&family=Spectral:ital,wght@0,400;0,600;1,400&family=Tiro+Devanagari+Sanskrit&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
