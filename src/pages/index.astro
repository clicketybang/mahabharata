---
/* The reader page. Story data comes only from the content collections:
   - frontmatter of moments, people, places → passed to the React island as JSON;
   - MDX bodies (beats, prose, time-jump links) → pre-rendered into <template data-moment> for the engine. */
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import Reader from "../components/Reader";
import Beat from "../components/mdx/Beat.astro";
import Jump from "../components/mdx/Jump.astro";
import tiers from "../data/variant-tiers.json";

const moments = (await getCollection("moments")).sort((a, b) => a.data.t_story - b.data.t_story);
const people = await getCollection("people");
const places = await getCollection("places");
const families = await getCollection("families");

const bodies = await Promise.all(
  moments.filter(m => m.data.status !== "unwritten").map(async m => ({ id: m.id, Content: (await render(m)).Content }))
);

const data = {
  moments: moments.map(m => ({ id: m.id, ...m.data })),
  people: people.map(p => ({ id: p.id, ...p.data })),
  places: places.map(p => ({ id: p.id, ...p.data })),
  families: families.map(f => ({ id: f.id, ...f.data })),
  tiers,
};
---
<Base>
  <Reader client:only="react" data={data} />
  {bodies.map(({ id, Content }) => (
    <template data-moment={id}><Content components={{ Beat, Jump }} /></template>
  ))}
</Base>
