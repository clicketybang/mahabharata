---
import Base from '../layouts/Base.astro';
---
<Base>
  <main>
    <h1>Mahābhārata</h1>
    <p lang="sa">महाभारतम्</p>
    <p>The Painted Epic — Astro scaffold. The v6 prototype will be ported here in Sprint 1.</p>
  </main>
</Base>
<style>
  main { max-width: 40rem; margin: 15vh auto; padding: 0 1.5rem; text-align: center; }
  h1 { font-size: 3.5rem; margin: 0; }
  p[lang="sa"] { font-size: 1.75rem; color: var(--madder); margin: .25rem 0 1.5rem; }
  p { color: var(--muted); }
</style>
